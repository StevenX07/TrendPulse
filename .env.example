# Apify API Token (cuenta gratuita o de pago) - En GitHub va únicamente en Repository Secrets
APIFY_API_TOKEN=your_apify_api_token_here

# Límite máximo automático por corrida semanal en Apify (5 actores ≈ $0.92/semana, ~$3.68-$4.00/mes)
APIFY_MAX_CHARGE_PER_RUN_USD=1.05

# Región base del monitor
DEFAULT_REGION=GLOBAL
